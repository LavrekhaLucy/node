{
  "swagger": "2.0",
  "info": {
    "description": "Auth endpoints: registration, login, token handling, password and email verification.",
    "version": "1.0.0",
    "title": "Auth API"
  },
  "host": "localhost:3000",
  "basePath": "/auth",
  "tags": [
    {
      "name": "auth",
      "description": "Authentication operations"
    }
  ],
  "schemes": ["http"],
  "paths": {
    "/sign-up": {
      "post": {
        "tags": ["auth"],
        "summary": "Register new user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/SignUpDto" }
          }
        ],
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation or email exists" }
        }
      }
    },
    "/sign-in": {
      "post": {
        "tags": ["auth"],
        "summary": "Sign in user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/SignInDto" }
          }
        ],
        "responses": {
          "200": { "description": "Tokens returned" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "Refresh token",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string",
            "description": "Bearer refreshToken"
          }
        ],
        "responses": {
          "200": { "description": "New tokens" },
          "403": { "description": "Invalid refresh token" }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout from current session",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/logout-all": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout from all sessions",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "All sessions cleared" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Send reset password email",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": { "type": "string" }
              },
              "required": ["email"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Email sent if exists" }
        }
      },
      "put": {
        "tags": ["auth"],
        "summary": "Reset password via token",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "newPassword": { "type": "string" }
              },
              "required": ["newPassword"]
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string",
            "description": "Bearer actionToken"
          }
        ],
        "responses": {
          "200": { "description": "Password updated" }
        }
      }
    },
    "/change-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Change password",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/ChangePasswordDto" }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Password changed" }
        }
      }
    },
    "/verify-email": {
      "post": {
        "tags": ["auth"],
        "summary": "Verify email via token",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/VerifyEmailDto" }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string",
            "description": "Bearer actionToken"
          }
        ],
        "responses": {
          "200": { "description": "Email verified" }
        }
      }
    }
  },
  "definitions": {
    "SignUpDto": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["name", "email", "password"]
    },
    "SignInDto": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["email", "password"]
    },
    "ChangePasswordDto": {
      "type": "object",
      "properties": {
        "oldPassword": { "type": "string" },
        "newPassword": { "type": "string" }
      },
      "required": ["oldPassword", "newPassword"]
    },
    "VerifyEmailDto": {
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  }
}
